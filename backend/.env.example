# Default zero-service local database. Run Alembic before starting the API.
DATABASE_URL=sqlite:///./lingualens.sqlite3
# PostgreSQL example: postgresql+psycopg://lingualens:<password>@localhost:5432/lingualens
WEB_ORIGIN=http://localhost:3000
SECURE_COOKIE=false
REGISTRATION_ENABLED=true
ALLOW_SHARED_PROVIDER_KEYS=true

# Job worker runs with the API unless disabled for verification or maintenance.
WORKER_ENABLED=true

# Optional shared server credentials for authenticated researchers.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional Fernet key. Required to store a key from AI Model Configuration.
CREDENTIAL_KEY=
# Backend-only Ollama address. Browser settings cannot override this host.
OLLAMA_HOST=http://127.0.0.1:11434
# Optional installed Ollama embedding model for explicitly requested similarity.
SEMANTIC_MODEL=
