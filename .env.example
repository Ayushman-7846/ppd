# Copy to .env for Compose. Set a unique local password before starting.
# Use URL-safe characters because Compose includes it in the database URL.
POSTGRES_PASSWORD=
WEB_ORIGIN=http://localhost:3000
SECURE_COOKIE=false
REGISTRATION_ENABLED=true
ALLOW_SHARED_PROVIDER_KEYS=false
WORKER_ENABLED=true

# Optional shared server credentials, forwarded only to the backend.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CREDENTIAL_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
SEMANTIC_MODEL=
